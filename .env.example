# Spotify Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/callback

# Last.fm Credentials
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_API_SECRET=your_lastfm_api_secret

# MusicBrainz
MUSICBRAINZ_USER_AGENT=EchoFinder/0.1.0 ( your_email@example.com )

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/echofinder

# Hybrid recommendation engine (shadow mode)
RECO_ENGINE_MODE=legacy
RECO_MODEL_VERSION=hybrid-v1
RECO_PAIR_SET_ID=default-v1
RECO_EPSILON=0.05
RECO_WEIGHT_RELATIONAL=0.45
RECO_WEIGHT_RAW=0.20
RECO_WEIGHT_RANK=0.15
RECO_WEIGHT_GENRE_SCENE=0.10
RECO_WEIGHT_ACTIVITY=0.05
RECO_WEIGHT_NOVELTY=0.05
RECO_FIRST_RELEASE_WINDOW_YEARS=8
RECO_RECENT_ACTIVITY_YEARS=2
RECO_MIN_RELEASE_COUNT=1
RECO_MIN_COVERAGE_SCORE=0.25
