# Normalize line endings consistently across platforms.
* text=auto

# Keep docs and source files LF for clean cross-platform diffs.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.example text eol=lf

# PowerShell scripts are typically edited/run on Windows.
*.ps1 text eol=crlf

# Binary assets.
*.pdf binary
